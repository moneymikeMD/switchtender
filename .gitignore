# ===== Real configuration (NEVER commit) =====
# config.example.toml is the committed template. config.toml describes a real
# commute, including where someone lives, and stays local.
config.toml
config.*.toml
!config.example.toml

# ===== Secrets / credentials (NEVER commit) =====
.env
.env.*
!.env.example
*.pem
*.key
service-account.json
*-service-account.json
credentials.json
secrets.json

# ===== Node =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Logs / temp =====
*.log
*.tmp
tmp/
.cache/

# ===== OS cruft =====
.DS_Store
._*
Thumbs.db
desktop.ini

# ===== Editor / IDE =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== Local-only (never commit) =====
Makefile

# ===== Tooling (repo-local, not shared) =====
.tokensave
.serena/
.memorygraph/
.claude/settings.local.json

# night-watchman working artifacts (wave trail, session cost); not project history
.night-watchman/
