# Copy to .env and fill in, or supply these however your environment prefers.
# .env is gitignored. On a maintainer machine these are provisioned by a
# password manager rather than written to disk, so do not assume a real file
# exists just because this template does.
#
# Only ROUTES_API_KEY is required. A missing optional key degrades exactly one
# signal and lowers confidence in the verdict; it never blocks one.

# Driving and transit durations. Required: without it there is no verdict.
ROUTES_API_KEY=

# Live road incidents on the stretch the regional feed does not reach.
# Optional. Losing it means congestion can still be measured but not explained,
# so the tool cannot tell a queue behind a crash from ordinary rush traffic.
TRAFFIC_API_KEY=

# Scheduled events at the configured venues. Optional.
EVENTS_API_KEY=

# Rail alerts. Optional.
TRANSIT_API_KEY=
